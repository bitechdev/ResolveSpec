FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/testserver ./cmd/testserver

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/testserver /usr/local/bin/testserver
COPY docker/testserver.config.yaml /etc/resolvespec/config.yaml
EXPOSE 8123
ENTRYPOINT ["testserver"]
